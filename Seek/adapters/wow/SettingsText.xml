<!-- A row of plain text on Seek's settings page (adapters/wow/Settings.lua),
     such as the explanation under the "Remove a character…" button. The
     Settings API has no row for a text of more than one line, so Seek has
     its own template. Settings.lua sets the text when the row is shown.
     Like Blizzard's rows (SettingsListElementTemplate), the text starts 37
     pixels from the left edge; the row's height (its Size) is room for two
     lines, which the page keeps for it. -->
<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="SeekSettingsTextTemplate" virtual="true">
    <Size x="280" y="32"/>
    <Layers>
      <Layer level="OVERLAY">
        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
          <Anchors>
            <Anchor point="TOPLEFT" x="37" y="0"/>
            <Anchor point="TOPRIGHT" x="-40" y="0"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
