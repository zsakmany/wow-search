## Interface: 16001
## Title: Seek
## Notes: A search bar for your bags, spells, and quests, and your other characters' bags.
## SavedVariables: SeekSuggestedKey, SeekSettings, SeekAccountData, SeekMinimapIcon
## SavedVariablesPerCharacter: SeekSavedCopy, SeekCharacterSettings
## AddonCompartmentFunc: Seek_OnAddonCompartmentClick
## IconAtlas: common-search-magnifyingglass

# Libraries (libs/README.md), before Seek's own files: LibDBIcon-1.0 for
# the minimap icon, and the libraries it needs, in the order they need
# each other.
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# Core: plain Lua 5.1 that never touches the WoW API (docs/adr/0003-hexagonal-core.md).
core\Locale.lua
core\Kinds.lua
core\Actions.lua
core\Combat.lua
core\Character.lua
core\Settings.lua
core\SettingsStore.lua
core\Storage.lua
core\Scheduler.lua
core\Clock.lua
core\Matcher.lua
core\Sources.lua
core\Picks.lua
core\CharacterBags.lua
core\SearchSession.lua

# WoW adapters. PublicApi.lua first: it publishes the global `Seek` that
# the sources register through. Storage.lua starts the core, and
# Settings.lua loads the settings, when the saved variables are loaded,
# after all of these files have run.
adapters\wow\PublicApi.lua
adapters\wow\CombatState.lua
adapters\wow\Character.lua
adapters\wow\Storage.lua
adapters\wow\Settings.lua
adapters\wow\Clock.lua
adapters\wow\Scheduler.lua
adapters\wow\Actions.lua
adapters\wow\SearchBar.lua
adapters\wow\Opening.lua
adapters\wow\MinimapIcon.lua
adapters\wow\SuggestedKey.lua
adapters\wow\LongText.lua
adapters\wow\BagSource.lua
adapters\wow\SpellSource.lua
adapters\wow\QuestSource.lua
