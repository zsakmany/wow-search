<!-- Seek's key binding, in its own "Seek" section of the game's Keybindings
     menu (like most addons). Do not use category="ADDONS" with a header:
     inside a shared section, the game shows a header as an empty spacer line.
     The label is set in adapters/wow/Opening.lua.
     WoW loads this file on its own; it is not listed in the TOC.
     No default key yet. -->
<Bindings>
  <Binding name="SEEK_TOGGLE" category="Seek">
    Seek_ToggleSearchBar()
  </Binding>
</Bindings>
